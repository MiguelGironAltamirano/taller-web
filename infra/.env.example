MYSQL_DATABASE=servicios
MYSQL_USER=servicios
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
FRONTEND_PORT=8088

# Local and staging only: adds demo users. Never set this in production.
APP_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed-dev

# At least 32 characters. Generate one per environment.
APP_JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# Storage path for uploaded evidences. Defaults to /app/evidences in docker.
APP_EVIDENCES_STORAGE_PATH=/app/evidences
