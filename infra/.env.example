MYSQL_DATABASE=servicios
MYSQL_USER=servicios
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
FRONTEND_PORT=8088

# Local and staging only, never in production. db/seed-dev adds the demo users; db/seed-demo (requires seed-dev)
# adds demo requests, history, comments, notifications, ratings and triage rules. Drop it for an empty database.
APP_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed-dev,classpath:db/seed-demo

# At least 32 characters. Generate one per environment.
APP_JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# Storage path for uploaded evidences. Defaults to /app/evidences in docker.
APP_EVIDENCES_STORAGE_PATH=/app/evidences

# Automatic closure of resolved requests the requester did not confirm. The period in hours is an
# administrator setting; these only switch the job and set how often it runs (ISO-8601 duration).
APP_WORKFLOW_AUTO_CLOSE_ENABLED=true
APP_WORKFLOW_AUTO_CLOSE_INTERVAL=PT15M

# Secure flag of the refresh-token cookie. Defaults to true; keep true in every HTTPS environment.
# Set false only for local stacks served over plain HTTP from a host other than localhost.
APP_AUTH_REFRESH_COOKIE_SECURE=true

# Comma-separated list of explicit origins allowed to call the API cross-origin (no wildcards).
# Leave empty when the SPA and the API share an origin through nginx (the default setup).
APP_CORS_ALLOWED_ORIGINS=

# Swagger UI (/swagger-ui.html) and the OpenAPI document (/v3/api-docs). Keep true in local and staging; set false
# in production so the API surface is not published there.
APP_API_DOCS_ENABLED=true

# Login with fingerprint or passkey (docs/api/passkeys-v1.md §3). A passkey only works on the domain it was created
# for: set the public domain (no scheme or port) in staging and production, and the exact origins the SPA is served
# from. Locally the defaults are localhost and http://localhost:${FRONTEND_PORT}. Outside localhost HTTPS is required.
# APP_AUTH_WEBAUTHN_RP_ID=servicios.example.pe
# APP_AUTH_WEBAUTHN_ALLOWED_ORIGINS=https://servicios.example.pe
