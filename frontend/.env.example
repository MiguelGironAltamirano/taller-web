# Copia este archivo a .env.local para sobrescribir los valores de desarrollo (.env.development).

# Usa la API simulada con MSW en lugar del backend. true solo en desarrollo o demostraciones.
VITE_ENABLE_MOCKS=false

# Muestra las cuentas de ejemplo en el login. Nunca en producción.
VITE_SHOW_DEMO_ACCOUNTS=false

# URL base de la API (por defecto /api/v1, servida por el mismo dominio o por el proxy de Vite).
# VITE_API_BASE=/api/v1
