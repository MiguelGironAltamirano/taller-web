# Copia este archivo a .env.local para sobrescribir valores en tu máquina.

# Usa la API simulada con MSW en lugar del backend y muestra cuentas de ejemplo en el login.
# true solo para desarrollo o demostraciones sin backend; nunca en producción.
VITE_USE_MOCKS=false

# URL base de la API (por defecto /api/v1, servida por el mismo dominio o por el proxy de Vite).
# VITE_API_BASE=/api/v1
